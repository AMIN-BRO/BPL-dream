#!/usr/bin/env python3
"""BPL Dream CLI - a lightweight dream journal."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

DATA_FILE = Path(__file__).with_name("dreams.json")


def load_dreams() -> list[dict[str, Any]]:
    if not DATA_FILE.exists():
        return []
    try:
        with DATA_FILE.open("r", encoding="utf-8") as file:
            data = json.load(file)
            if isinstance(data, list):
                return data
    except json.JSONDecodeError:
        return []
    return []


def save_dreams(dreams: list[dict[str, Any]]) -> None:
    with DATA_FILE.open("w", encoding="utf-8") as file:
        json.dump(dreams, file, indent=2)
        file.write("\n")


def add_dream(title: str, mood: str, notes: str) -> None:
    dreams = load_dreams()
    dreams.append({
        "title": title,
        "mood": mood,
        "notes": notes,
    })
    save_dreams(dreams)
    print(f"Dream saved: {title}")


def list_dreams() -> None:
    dreams = load_dreams()
    if not dreams:
        print("No dreams recorded yet.")
        return

    for index, dream in enumerate(dreams, start=1):
        print(f"{index}. {dream['title']} [{dream['mood']}]")
        print(f"   {dream['notes']}")


def search_dreams(keyword: str) -> None:
    dreams = load_dreams()
    matches = [dream for dream in dreams if keyword.lower() in (dream.get("title", "") + " " + dream.get("notes", "")).lower()]

    if not matches:
        print(f"No dreams matched '{keyword}'.")
        return

    for dream in matches:
        print(f"- {dream['title']} [{dream['mood']}]: {dream['notes']}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="BPL Dream journal")
    subparsers = parser.add_subparsers(dest="command", required=True)

    add_parser = subparsers.add_parser("add", help="Add a new dream")
    add_parser.add_argument("title")
    add_parser.add_argument("--mood", default="neutral")
    add_parser.add_argument("--notes", default="")

    subparsers.add_parser("list", help="List all saved dreams")

    search_parser = subparsers.add_parser("search", help="Search dreams")
    search_parser.add_argument("keyword")

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "add":
        add_dream(args.title, args.mood, args.notes)
    elif args.command == "list":
        list_dreams()
    elif args.command == "search":
        search_dreams(args.keyword)


if __name__ == "__main__":
    main()
